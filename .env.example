# ---------------------------------------------------------------------------
# GridironIQ environment template.
# Copy the relevant section into backend/.env and frontend/.env — never commit
# the real .env files.
# ---------------------------------------------------------------------------

# --- Backend (backend/.env) ---
# Matches the credentials defined in docker-compose.yml for local development.
DATABASE_URL=postgresql://gridiron:gridiron@localhost:5432/gridiron
ENVIRONMENT=development
# Comma-separated origins allowed to call the API. Local dev default shown;
# in production set this to the deployed frontend URL, e.g.
# CORS_ORIGINS=https://gridiron-iq.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env) ---
# Local dev default shown; in production (Vercel) set this to the deployed
# backend URL, e.g. VITE_API_BASE_URL=https://gridiron-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Production notes:
#   - Backend (Render): set DATABASE_URL (Supabase connection string) and
#     CORS_ORIGINS (the Vercel URL) as environment variables in the dashboard.
#   - Frontend (Vercel): set VITE_API_BASE_URL to the Render backend URL.
#   - The database lives on Supabase in production instead of local Docker.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# GridironIQ environment template.
# Copy the relevant section into backend/.env and frontend/.env — never commit
# the real .env files.
# ---------------------------------------------------------------------------

# --- Backend (backend/.env) ---
# Matches the credentials defined in docker-compose.yml for local development.
DATABASE_URL=postgresql://gridiron:gridiron@localhost:5432/gridiron
ENVIRONMENT=development

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000

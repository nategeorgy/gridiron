# ---------------------------------------------------------------------------
# GridironIQ environment template.
# Copy the relevant section into backend/.env and frontend/.env — never commit
# the real .env files.
# ---------------------------------------------------------------------------

# --- Backend (backend/.env) ---
# Matches the credentials defined in docker-compose.yml for local development.
DATABASE_URL=postgresql://gridiron:gridiron@localhost:5432/gridiron
ENVIRONMENT=development
# Comma-separated exact origins allowed to call the API. Local dev default shown;
# in production set this to the deployed frontend URL, e.g.
# CORS_ORIGINS=https://gridiron-iq.vercel.app
CORS_ORIGINS=http://localhost:5173
# Regex of additional allowed origins (full-matched). Defaults in code to this
# project's Vercel URLs so preview deploys are allowed without listing each one.
# Override here to match your project, or set empty to disable.
# CORS_ORIGIN_REGEX=https://gridiron-[a-z0-9-]+\.vercel\.app

# --- Accounts / Supabase Auth (M5) ---
# Sign-in is email-based: password or magic link. There is no OAuth app to register,
# but Supabase must have the Email provider enabled and — before real traffic — a real
# SMTP sender configured, since confirmation, magic links, and password resets all
# depend on mail arriving. See docs/design/M5-accounts-saved-state.md section 8.
# Optional. Leave both unset and the API runs with accounts disabled: every public
# endpoint works exactly as before and the /me endpoints return 503.
# The Supabase project URL, used to derive the token issuer and JWKS endpoint.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Only needed for older projects still signing JWTs symmetrically (HS256). Newer
# projects sign asymmetrically and are verified from the public JWKS — no secret here.
# Find it under Supabase → Project Settings → API → JWT Settings.
# SUPABASE_JWT_SECRET=

# --- Frontend (frontend/.env) ---
# Local dev default shown; in production (Vercel) set this to the deployed
# backend URL, e.g. VITE_API_BASE_URL=https://gridiron-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
# Accounts (M5). Optional — with these unset the app runs exactly as it did before
# accounts existed, minus the sign-in button. The anon key is a publishable key and
# is safe in a client bundle; the service_role key must NEVER appear here.
# NOTE: this is the *project* URL, not one of the API endpoints shown next to it in
# the Supabase dashboard. ".../rest/v1" or ".../auth/v1" here makes sign-in fail with
# PostgREST's opaque "Invalid path specified in request URL". The client strips such a
# suffix and warns in the console, but set it correctly.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<publishable anon key>

# ---------------------------------------------------------------------------
# Production notes:
#   - Backend (Render): set DATABASE_URL (Supabase connection string) and
#     CORS_ORIGINS (the Vercel URL) as environment variables in the dashboard.
#   - Frontend (Vercel): set VITE_API_BASE_URL to the Render backend URL.
#   - The database lives on Supabase in production instead of local Docker.
# ---------------------------------------------------------------------------

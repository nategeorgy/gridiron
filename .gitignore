# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Python (backend, pipeline) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- Editors / OS ---
.DS_Store

# Excel lock files — created while a workbook in docs/ is open, removed on close
~$*.xlsx
.idea/
.vscode/
.obsidian/
*.swp

# --- Hand-supplied data ---
# Weekly routes exports are licensed charting data and this repo is public. The folder
# holds its README only; the files are loaded from a local copy and never committed.
pipeline/data/routes/*
!pipeline/data/routes/README.md

# --- Docker ---
# Postgres data lives in a named volume, not the tree, but ignore any local dumps
*.dump

# --- Alembic ---
# Keep migration scripts, but they live under alembic/versions and ARE committed.
